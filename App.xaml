<Application x:Class="TamilMaganBroadcastPro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#080808"/>
        <SolidColorBrush x:Key="Panel" Color="#171717"/>
        <SolidColorBrush x:Key="Panel2" Color="#222222"/>
        <SolidColorBrush x:Key="Accent" Color="#B34AE8"/>
        <SolidColorBrush x:Key="TextMain" Color="#E9E9E9"/>
        <SolidColorBrush x:Key="TextDim" Color="#9A9A9A"/>
        <Style x:Key="PreviewBorder" TargetType="Border">
            <Setter Property="Background" Value="#303030"/>
            <Setter Property="BorderBrush" Value="#555055"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F4E9FA"/>
            <Setter Property="Background" Value="#29202F"/>
            <Setter Property="BorderBrush" Value="#75408A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>
    </Application.Resources>
</Application>
