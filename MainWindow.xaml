
<Window x:Class="TamilMaganBroadcastPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="TAMIL MAGAN TV - BROADCAST PRO"
        Height="850" Width="1450"
        MinHeight="650" MinWidth="1000"
        Background="#101014"
        Foreground="White"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#292333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="#8B45D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1B1B24"
                CornerRadius="6" Padding="12">
            <DockPanel>
                <TextBlock Text="TAMIL MAGAN TV"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#B77BFF"
                           VerticalAlignment="Center"/>
                <TextBlock Text="BROADCAST PRO"
                           FontSize="16" Margin="18,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="ON AIR : OFFLINE"
                           Foreground="#FF6464"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- VIDEO MONITORS -->
        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#08080B"
                    BorderBrush="#8B45D9"
                    BorderThickness="2"
                    CornerRadius="5" Margin="4">
                <Grid>
                    <vlc:VideoView x:Name="PreviewVideoView"/>
                    <TextBlock Text="PREVIEW"
                               Foreground="#B77BFF"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Margin="10"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="#08080B"
                    BorderBrush="#8B45D9"
                    BorderThickness="2"
                    CornerRadius="5" Margin="4">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PROGRAM / LIVE"
                               Foreground="#FF5555"
                               FontSize="18"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="NO VIDEO"
                               Foreground="#777777"
                               FontSize="25"
                               HorizontalAlignment="Center"
                               Margin="0,15"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- CONTROL MENU -->
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal">
                <Button Content="PLAY LIST"/>
                <Button Content="INSTANT"/>
                <Button Content="AD ENTRY"/>
                <Button Content="CG"/>
                <Button Content="SETTINGS"/>
                <Button Content="LIVE"/>
                <Button Content="UDP+"/>
                <Button Content="WEB URL"/>
                <Button Content="EQUALIZER"/>
                <Button Content="NEWS"/>
                <Button Content="TITLE CG"/>
                <Button Content="RTMP"/>
            </StackPanel>
        </ScrollViewer>

        <!-- PLAYLIST -->
        <Border Grid.Row="3"
                Background="#1B1B24"
                CornerRadius="5"
                Padding="8"
                Margin="0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock Text="PLAYLIST"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#B77BFF"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="ADD FILE"
                                Click="AddFile_Click"/>
                        <Button Content="REMOVE"
                                Click="Remove_Click"/>
                        <Button Content="PLAY"
                                Click="Play_Click"/>
                        <Button Content="STOP"
                                Click="Stop_Click"/>
                    </StackPanel>
                </DockPanel>

                <DataGrid x:Name="PlaylistGrid"
                          Grid.Row="1"
                          Background="#17171E"
                          Foreground="White"
                          RowBackground="#24242E"
                          AlternatingRowBackground="#30303B"
                          HeadersVisibility="Column"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NO"
                                            Binding="{Binding [NO]}"
                                            Width="60"/>
                        <DataGridTextColumn Header="FILE NAME"
                                            Binding="{Binding [FILE NAME]}"
                                            Width="*"/>
                        <DataGridTextColumn Header="DURATION"
                                            Binding="{Binding [DURATION]}"
                                            Width="120"/>
                        <DataGridTextColumn Header="STATUS"
                                            Binding="{Binding [STATUS]}"
                                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="4"
                Background="#25212D"
                CornerRadius="4"
                Padding="8">
            <DockPanel>
                <TextBlock x:Name="StatusText"
                           Text="SYSTEM READY"
                           Foreground="#55DD99"/>
                <TextBlock Text="TAMIL MAGAN TV BROADCAST PRO"
                           HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
